# 2.3. APLICACIONES A LA INGENIERÍA MECÁNICA
# =============================================================================

def animar_aplicacion_mecanica():
    """2.3.1 Aplicación a Ing. Mecánica: Pandeo y flexibilidad en viga."""
    a, b = 1.0, 1.45
    steps = []
    for _ in range(10):
        fa, fb = f_mecanica(a), f_mecanica(b)
        c = b - (fb * (b - a)) / (fb - fa)
        fc = f_mecanica(c)
        steps.append((c, fc))
        if fa * fc < 0:
            b = c
        else:
            a = c

    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(9, 7))
    theta_vals = np.linspace(1.0, 1.48, 300)

    def update(frame):
        c_k, fc_k = steps[frame]
        
        # Gráfica matemática
        ax1.clear()
        ax1.plot(theta_vals, f_mecanica(theta_vals), 'b-', lw=2, label=r'$f(\theta) = \tan(\theta) - 2\theta$')
        ax1.axhline(0, color='gray', linestyle='--')
        ax1.plot(c_k, fc_k, 'ro', ms=8, label=f'Ángulo crítico $\\theta = {c_k:.4f}$ rad')
        ax1.grid(True, alpha=0.3)
        ax1.set_title(f"2.3.1 Ing. Mecánica - Iteración {frame+1}: $\\theta_c \\approx {c_k:.4f}$ rad ({np.degrees(c_k):.2f}°)")
        ax1.legend(loc='upper left')
        
        # Esquema mecánico
        ax2.clear()
        L = 10.0
        x_beam = np.linspace(0, L, 100)
        deflection = np.sin(np.pi * x_beam / L) * (c_k * 1.5)
        
        ax2.plot(x_beam, deflection, 'orange', lw=4, label='Modo de Pandeo en Viga')
        ax2.plot([0, L], [0, 0], 'k--', alpha=0.5)
        ax2.plot(0, 0, '^r', ms=12)
        ax2.plot(L, 0, 'or', ms=10)
        
        ax2.set_ylim(-1.5, 2.5)
        ax2.set_title("Esquema Físico: Deformada de la Viga bajo Carga Axial")
        ax2.grid(True, alpha=0.3)
        ax2.legend(loc='upper left')

    anim = FuncAnimation(fig, update, frames=len(steps), interval=1200, repeat=True)
    plt.tight_layout()
    plt.show()


